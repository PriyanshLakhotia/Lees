{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word": { "type": "string" },
          "lemma": { "type": "string" },
          "meaning": { "type": "string" },
          "partOfSpeech": { "type": "string" },
          "difficulty": {
            "type": "string",
            "enum": ["common", "useful", "advanced"]
          },
          "exampleNl": { "type": "string" },
          "exampleEn": { "type": "string" }
        },
        "required": [
          "word",
          "lemma",
          "meaning",
          "partOfSpeech",
          "difficulty",
          "exampleNl",
          "exampleEn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["entries"],
  "additionalProperties": false
}
